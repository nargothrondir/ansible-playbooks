# {{ ansible_managed }}
# Read automatically by docker compose from the project directory. The compose
# file itself lives in the docker-stacks repository and carries no values —
# every host-specific one is here, which is why this file is 0600 and the
# compose file is not.
DOCKHAND_SERVER_URL={{ hawser_dockhand_url }}
TOKEN={{ hawser_token }}
STACKS_DIR={{ hawser_stacks_dir }}
REQUEST_TIMEOUT={{ hawser_request_timeout }}
